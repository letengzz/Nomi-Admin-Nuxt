# ---------------------------------------------------------------------------
# 权限系统 / MySQL 配置
#
# 复制为 .env 后修改。Nuxt 在 dev 与 build 时自动读取 .env；
# 生产部署（Docker / systemd）请直接注入环境变量，不要把 .env 打进镜像。
# ---------------------------------------------------------------------------

# MySQL 连接。库不存在时会自动 CREATE DATABASE，表不存在时自动建表并灌种子数据。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nomi_admin

# 连接池上限。中后台的并发量不高，10 个连接足够；调大只会让 MySQL 更早拒绝新连接。
MYSQL_POOL_SIZE=10

# token 表的 HMAC 密钥。**上线前必须改成一串随机值**，改掉等于让所有登录态立即失效。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
