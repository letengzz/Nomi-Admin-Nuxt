# ---------------------------------------------------------------------------
# 权限系统 / MySQL 配置
#
# 复制为 .env 后修改。Nuxt 在 dev 与 build 时自动读取 .env；
# 生产部署（Docker / systemd）请直接注入环境变量，不要把 .env 打进镜像。
# ---------------------------------------------------------------------------

# MySQL 连接。库不存在时会自动 CREATE DATABASE，表不存在时自动建表并灌种子数据。
# 注意 MYSQL_PASSWORD 在这条路径上是「MYSQL_USER 的密码」；容器部署时它指 nomi 账号，
# 两套账号的区别见文件末尾的 Docker Compose 段。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nomi_admin

# 连接池上限。中后台的并发量不高，10 个连接足够；调大只会让 MySQL 更早拒绝新连接。
MYSQL_POOL_SIZE=10

# token 表的 HMAC 密钥。**上线前必须改成一串随机值**，改掉等于让所有登录态立即失效。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Docker Compose（compose.yaml）
#
# 只在容器部署时需要。compose 会读同目录的 .env 做**变量替换**（不会把整个文件塞进容器）。
#
# 注意：上面那组 MYSQL_* 和这里**不是同一套账号**，别混着填。
#
#   A. 本机开发 / Node 直跑（pnpm dev、node .output/server/index.mjs）
#      只用上面那组：MYSQL_USER 默认 root，MYSQL_PASSWORD 是这台 MySQL 里 root 的密码。
#      MYSQL_ROOT_PASSWORD 在这条路径上不会被任何代码读取。
#
#   B. Docker Compose
#      账号由 compose.yaml 写死：容器里 MYSQL_USER=nomi，上面写的 root 会被忽略。
#      于是同一个变量名 MYSQL_PASSWORD 在这条路径上变成「nomi 账号的密码」：
#        MYSQL_PASSWORD       —— 镜像首启时按它创建 nomi 账号，应用也用它连库
#        MYSQL_ROOT_PASSWORD  —— 容器内 MySQL 的 root 密码，只被 healthcheck 与
#                                mysqldump 备份命令用到，应用代码不读它
#      两者可以不同，也建议不同：业务跑在 nomi（权限仅限 MYSQL_DATABASE），
#      root 只在维护时出现。
#
#      坑：nomi 账号只在 mysql_data 卷**首次初始化**时创建。之后改这个密码不会作用于
#      已有卷，应用会直接连不上 —— 需要进容器 ALTER USER，或删卷重来。
#
#   TOKEN_SECRET —— 两条路径都用，不配会让容器起不来（刻意如此）。
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
