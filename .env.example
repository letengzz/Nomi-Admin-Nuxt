# ---------------------------------------------------------------------------
# 权限系统 / MySQL 配置
#
# 复制为 .env 后修改。Nuxt 在 dev 与 build 时自动读取 .env；
# 生产部署（Docker / systemd）请直接注入环境变量，不要把 .env 打进镜像。
# ---------------------------------------------------------------------------

# MySQL 连接。库不存在时会自动 CREATE DATABASE，表不存在时自动建表并灌种子数据。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nomi_admin

# 连接池上限。中后台的并发量不高，10 个连接足够；调大只会让 MySQL 更早拒绝新连接。
MYSQL_POOL_SIZE=10

# token 表的 HMAC 密钥。**上线前必须改成一串随机值**，改掉等于让所有登录态立即失效。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Docker Compose（compose.yaml）
#
# 只在容器部署时需要。compose 会读同目录的 .env 做**变量替换**（不会把整个文件塞进容器），
# 其中：
#   MYSQL_PASSWORD       —— 应用连库用的 nomi 账号密码，与上面同一个变量
#   MYSQL_ROOT_PASSWORD  —— 容器内 MySQL 的 root 密码，只有 compose 用得到，应用不碰
#   TOKEN_SECRET         —— 同上，不配会让容器起不来（刻意如此）
# 应用容器里的 MYSQL_HOST 固定为 `mysql`、用户固定为 `nomi`，与上面的本地配置无关。
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
